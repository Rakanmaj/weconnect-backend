# Create PostgreSQL yourself, then run database/weconnect_weeks_1_4.sql in that database.
# Copy this file to .env and replace the connection details below.
# URL-encode special characters in the database password (for example @ becomes %40).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/weconnect
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Week 2 email links. APP_URL must be the browser origin, not the API URL.
APP_URL=http://localhost:3000
# Local development: emails are private files in .local/mail; no real email is sent.
MAIL_MODE=outbox
MAIL_OUTBOX=.local/mail
# For actual email delivery use MAIL_MODE=smtp and supply these values.
# Production requires SMTP; the local outbox is disabled in production.
# MAIL_FROM=WeConnect <noreply@your-domain.example>
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=YOUR_SMTP_USERNAME
# SMTP_PASSWORD=YOUR_SMTP_PASSWORD

# Optional development seed only. Never enable demo accounts on a public deployment.
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=WeConnect2026!

# Optional private administrator creation, used by npm run auth:create-admin.
# ADMIN_EMAIL=admin@your-domain.example
# ADMIN_PASSWORD=YOUR_PRIVATE_PASSWORD
# ADMIN_NAME=Administrator

# JavaScript exercise execution. Local WebAssembly sandbox needs no external account.
CODE_RUNNER_MODE=local
# Optional alternative Judge0-compatible service; backend-only configuration.
# CODE_RUNNER_URL=http://127.0.0.1:2358
# CODE_RUNNER_TOKEN=YOUR_RUNNER_TOKEN
# CODE_RUNNER_LANGUAGE_ID=63
