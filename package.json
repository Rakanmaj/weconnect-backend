{
  "name": "weconnect-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src src/index.js",
    "start": "node src/index.js --serve",
    "preview": "node src/index.js --serve",
    "serve": "node src/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "lint": "eslint .",
    "db:migrate": "node src/scripts/migrate.js",
