    "test:lab-privacy": "node tools/check-lab-privacy.mjs"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "quickjs-emscripten": "^0.32.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "supertest": "^7.3.1",
    "eslint": "9.39.5"
